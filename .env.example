DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/neurodash"
SESSION_SECRET="a long random string"

# Local server data folder: the same folder localserver/patients_store.py uses (DATA_FOLDER).
# Registering a patient creates <folder>/<patient ID>/ + patient.json and updates patients.json;
# uploaded sessions.csv / configdata.csv are read from here. Leave empty to turn the integration off.
NEURODASH_DATA_DIR="D:/NeuroDashData"
# How often (seconds) the app scans that folder for new uploads. 0 = only when "Sync now" is pressed.
INGEST_INTERVAL_SECONDS=30
ACTIVE_WINDOW_SECONDS=300

# Saved patient reports are written here (default: <NEURODASH_DATA_DIR>/_reports). Local for now; S3 later.
# REPORTS_DIR="D:/NeuroDashData/_reports"
