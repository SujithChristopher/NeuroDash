    {
      "id": "s2",
      "title": "ACTION RESEARCH ARM TEST (ARAT) - SCORING SCALE",
      "items": [
        {
          "id": "arat_scoring_info",
          "redcapType": "descriptive",
          "type": "info",
          "label": "0 - Unable to finish the task\n1 - Can finish the task partially regardless of position/movements\n2 - Can finish the task but takes abnormally long, has great difficulty, or has improper body posture/hand/arm movements\n3 - Finished the task quickly with the appropriate body position and normal hand/arm movements",
          "labelHtml": "<b>0</b> - Unable to finish the task<br><b>1</b> - Can finish the task partially regardless of position/movements<br><b>2</b> - Can finish the task but takes abnormally long, has great difficulty, or has improper body posture/hand/arm movements<br><b>3</b> - Finished the task quickly with the appropriate body position and normal hand/arm movements"
        }
      ]
    },
