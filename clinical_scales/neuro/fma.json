          "label": "Examiner Name"
        }
      ]
    },
    {
      "id": "s2",
      "title": "FUGL-MEYER ASSESSMENT UPPER EXTREMITY (FMA-UE) - Sitting Position",
      "items": [
        {
          "id": "fma_ue_header",
          "redcapType": "descriptive",
          "type": "info",
          "label": "A. UPPER EXTREMITY"
        }
      ]
    },
    {
      "id": "s3",
      "title": "I. Reflex Activity",
      "items": [
        {
          "id": "fma_ue_reflex_flex",
          "redcapType": "radio",
          "type": "single_choice",
          "choices": [
            {
              "value": 0,
              "label": "None (can be elicited)"
            },
            {
              "value": 2,
              "label": "Reflexes present"
            }
          ],
          "widget": "buttons",
          "label": "Flexors: biceps and finger flexors (at least one)"
        },
        {
          "id": "fma_ue_reflex_ext",
          "redcapType": "radio",
          "type": "single_choice",
          "choices": [
            {
              "value": 0,
              "label": "None (can be elicited)"
            },
            {
              "value": 2,
              "label": "Reflexes present"
            }
          ],
          "widget": "buttons",
          "label": "Extensors: triceps"
        },
        {
          "id": "fma_ue_subtotal_i",
          "redcapType": "calc",
          "type": "computed",
          "expr": "fma_ue_reflex_flex + fma_ue_reflex_ext",
          "exprRaw": "[fma_ue_reflex_flex] + [fma_ue_reflex_ext]",
          "label": "Subtotal I (max 4)"
        }
      ]
    },
    {
      "id": "s4",
      "title": "II. Volitional movement within synergies",
      "items": [
        {
          "id": "fma_ue_flex_desc",
          "redcapType": "descriptive",
          "type": "info",
          "label": "Flexor synergy: Hand from contralateral knee to ipsilateral ear. From extensor synergy (shoulder adduction/ internal rotation, elbow extension, forearm pronation) to flexor synergy (shoulder abduction/ external rotation, elbow flexion, forearm supination)."
        },
        {
          "id": "fma_ue_flex_retract",
          "redcapType": "radio",
          "type": "single_choice",
          "choices": [
            {
              "value": 0,
              "label": "None"
            },
            {
              "value": 1,
              "label": "Partial"
            },
            {
              "value": 2,
              "label": "Full"
            }
          ],
          "widget": "buttons",
          "label": "Shoulder retraction"
        },
        {
          "id": "fma_ue_flex_elev",
          "redcapType": "radio",
          "type": "single_choice",
          "choices": [
            {
              "value": 0,
              "label": "None"
            },
            {
              "value": 1,
              "label": "Partial"
            },
            {
              "value": 2,
              "label": "Full"
            }
          ],
          "widget": "buttons",
          "label": "Shoulder elevation"
        },
        {
          "id": "fma_ue_flex_abd",
          "redcapType": "radio",
          "type": "single_choice",
          "choices": [
            {
              "value": 0,
              "label": "None"
            },
            {
              "value": 1,
              "label": "Partial"
            },
            {
              "value": 2,
              "label": "Full"
            }
          ],
          "widget": "buttons",
          "label": "Shoulder abduction (90 degrees)"
        },
        {
          "id": "fma_ue_flex_extrot",
          "redcapType": "radio",
          "type": "single_choice",
          "choices": [
            {
              "value": 0,
              "label": "None"
            },
            {
              "value": 1,
              "label": "Partial"
            },
            {
              "value": 2,
              "label": "Full"
            }
          ],
          "widget": "buttons",
          "label": "Shoulder external rotation"
        },
        {
          "id": "fma_ue_flex_elb",
          "redcapType": "radio",
          "type": "single_choice",
          "choices": [
            {
              "value": 0,
              "label": "None"
            },
            {
              "value": 1,
              "label": "Partial"
            },
            {
              "value": 2,
              "label": "Full"
            }
          ],
          "widget": "buttons",
          "label": "Elbow flexion"
        },
        {
          "id": "fma_ue_flex_sup",
          "redcapType": "radio",
          "type": "single_choice",
          "choices": [
            {
              "value": 0,
              "label": "None"
            },
            {
              "value": 1,
              "label": "Partial"
            },
            {
              "value": 2,
              "label": "Full"
            }
          ],
          "widget": "buttons",
          "label": "Forearm supination"
        },
        {
          "id": "fma_ue_ext_desc",
          "redcapType": "descriptive",
          "type": "info",
          "label": "Extensor synergy: Hand from ipsilateral ear to the contralateral knee."
        },
        {
          "id": "fma_ue_ext_add",
          "redcapType": "radio",
          "type": "single_choice",
          "choices": [
            {
              "value": 0,
              "label": "None"
            },
            {
              "value": 1,
              "label": "Partial"
            },
            {
              "value": 2,
              "label": "Full"
            }
          ],
          "widget": "buttons",
          "label": "Shoulder adduction/internal rotation"
        },
        {
          "id": "fma_ue_ext_elb",
          "redcapType": "radio",
          "type": "single_choice",
          "choices": [
            {
              "value": 0,
              "label": "None"
            },
            {
              "value": 1,
              "label": "Partial"
            },
            {
              "value": 2,
              "label": "Full"
            }
          ],
          "widget": "buttons",
          "label": "Elbow extension"
        },
        {
          "id": "fma_ue_ext_pron",
          "redcapType": "radio",
          "type": "single_choice",
          "choices": [
            {
              "value": 0,
              "label": "None"
            },
            {
              "value": 1,
              "label": "Partial"
            },
            {
              "value": 2,
              "label": "Full"
            }
          ],
          "widget": "buttons",
          "label": "Forearm pronation"
        },
        {
          "id": "fma_ue_subtotal_ii",
          "redcapType": "calc",
          "type": "computed",
          "expr": "fma_ue_flex_retract+fma_ue_flex_elev+fma_ue_flex_abd+fma_ue_flex_extrot+fma_ue_flex_elb+fma_ue_flex_sup+fma_ue_ext_add+fma_ue_ext_elb+fma_ue_ext_pron",
          "exprRaw": "[fma_ue_flex_retract]+[fma_ue_flex_elev]+[fma_ue_flex_abd]+[fma_ue_flex_extrot]+[fma_ue_flex_elb]+[fma_ue_flex_sup]+[fma_ue_ext_add]+[fma_ue_ext_elb]+[fma_ue_ext_pron]",
          "label": "Subtotal II (max 18)"
        }
      ]
    },
    {
      "id": "s5",
      "title": "III. Volitional movement mixing synergies",
      "items": [
        {
          "id": "fma_ue_mix_lumbar",
          "redcapType": "radio",
          "type": "single_choice",
          "choices": [
            {
              "value": 0,
              "label": "Cannot perform"
            },
            {
              "value": 1,
              "label": "Hand behind ant-sup iliac spine"
            },
            {
              "value": 2,
              "label": "Hand to lumbar spine"
            }
          ],
          "widget": "buttons",
          "label": "Hand to lumbar spine"
        },
        {
          "id": "fma_ue_mix_flex",
          "redcapType": "radio",
          "type": "single_choice",
          "choices": [
            {
              "value": 0,
              "label": "Immediate abduction/elbow flexion"
            },
            {
              "value": 1,
              "label": "Abduction/elbow flexion during movement"
            },
            {
              "value": 2,
              "label": "Flexion 90 deg / no abduction or elbow flexion"
            }
          ],
          "widget": "buttons",
          "label": "Shoulder flexion 0-90 degrees (elbow at 0)"
        },
        {
          "id": "fma_ue_mix_prosup",
          "redcapType": "radio",
          "type": "single_choice",
          "choices": [
            {
              "value": 0,
              "label": "No pron/sup / starting pos impossible"
            },
            {
              "value": 1,
              "label": "Limited pron/sup / maintains start pos"
            },
            {
              "value": 2,
              "label": "Full pron/sup / maintains start pos"
            }
          ],
          "widget": "buttons",
          "label": "Pronation-supination (elbow at 90, shoulder at 0)"
        },
        {
          "id": "fma_ue_subtotal_iii",
          "redcapType": "calc",
          "type": "computed",
          "expr": "fma_ue_mix_lumbar + fma_ue_mix_flex + fma_ue_mix_prosup",
          "exprRaw": "[fma_ue_mix_lumbar] + [fma_ue_mix_flex] + [fma_ue_mix_prosup]",
          "label": "Subtotal III (max 6)"
        }
      ]
    },
    {
      "id": "s6",
      "title": "IV. Volitional movement little/no synergy",
      "items": [
        {
          "id": "fma_ue_vol_abd",
          "redcapType": "radio",
          "type": "single_choice",
          "choices": [
            {
              "value": 0,
              "label": "Immediate supination/elbow flexion"
            },
            {
              "value": 1,
              "label": "Supination/elbow flexion during movement"
            },
            {
              "value": 2,
              "label": "Abduction 90 deg / maintains ext & pron"
            }
          ],
          "widget": "buttons",
          "label": "Shoulder abduction 0-90 degrees (elbow at 0, forearm pronated)"
        },
        {
          "id": "fma_ue_vol_flex",
          "redcapType": "radio",
          "type": "single_choice",
          "choices": [
            {
              "value": 0,
              "label": "Immediate abduction/elbow flexion"
            },
            {
              "value": 1,
              "label": "Abduction/elbow flexion during movement"
            },
            {
              "value": 2,
              "label": "Flexion 180 deg / no abduction or elbow flexion"
            }
          ],
          "widget": "buttons",
          "label": "Shoulder flexion 90-180 degrees (elbow at 0, pron-sup at 0)"
        },
        {
          "id": "fma_ue_vol_prosup",
          "redcapType": "radio",
          "type": "single_choice",
          "choices": [
            {
              "value": 0,
              "label": "No pron/sup / starting pos impossible"
            },
            {
              "value": 1,
              "label": "Limited pron/sup / maintains start pos"
            },
            {
              "value": 2,
              "label": "Full pron/sup / maintains start pos"
            }
          ],
          "widget": "buttons",
          "label": "Pronation/supination (elbow at 0, shoulder at 30-90 flexion)"
        },
        {
          "id": "fma_ue_subtotal_iv",
          "redcapType": "calc",
          "type": "computed",
          "expr": "fma_ue_vol_abd + fma_ue_vol_flex + fma_ue_vol_prosup",
          "exprRaw": "[fma_ue_vol_abd] + [fma_ue_vol_flex] + [fma_ue_vol_prosup]",
          "label": "Subtotal IV (max 6)"
        }
      ]
    },
    {
      "id": "s7",
      "title": "V. Normal reflex activity",
      "items": [
        {
          "id": "fma_ue_norm_reflex",
          "redcapType": "radio",
          "type": "single_choice",
          "choices": [
            {
              "value": 0,
              "label": "2 of 3 markedly hyperactive OR score 0 in part IV"
            },
            {
              "value": 1,
              "label": "1 reflex markedly hyperactive or >=2 lively"
            },
            {
              "value": 2,
              "label": "Max 1 reflex lively / none hyperactive"
            }
          ],
          "widget": "buttons",
          "label": "Normal reflex activity (assessed only if full score of 6 in part IV)"
        },
        {
          "id": "fma_ue_total_a",
          "redcapType": "calc",
          "type": "computed",
          "expr": "fma_ue_subtotal_i+fma_ue_subtotal_ii+fma_ue_subtotal_iii+fma_ue_subtotal_iv+fma_ue_norm_reflex",
          "exprRaw": "[fma_ue_subtotal_i]+[fma_ue_subtotal_ii]+[fma_ue_subtotal_iii]+[fma_ue_subtotal_iv]+[fma_ue_norm_reflex]",
          "label": "Total A (max 36)"
        }
      ]
    },
