{
  "id": "fma",
  "version": 1,
  "title": "Fugl-Meyer Assessment (Upper Extremity)",
  "redcapForm": "fugl_meyer_assessment_ue",
  "sections": [
    {
      "id": "s1",
      "title": "",
      "items": [
        {
          "id": "record_id",
          "redcapType": "text",
          "type": "subject_ref",
          "source": "patient",
          "label": "Record ID"
        },
        {
          "id": "date_of_assessment",
