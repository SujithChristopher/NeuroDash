          "label": "Record ID"
        },
        {
          "id": "mrs_date",
          "redcapType": "text",
          "type": "date",
          "widget": "datepicker",
          "defaultToday": true,
          "label": "Date of Assessment"
        },
        {
          "id": "mrs_examiner",
          "redcapType": "text",
          "type": "examiner",
          "widget": "staff_dropdown",
