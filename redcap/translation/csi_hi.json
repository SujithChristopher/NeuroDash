            "form": "caregiver_strain_index",
            "label": {
                "translation": "8. There have been emotional adjustments (e.g., because of severe arguments) <br> 8. भावनात्मक समायोजन हुए हैं (उदाहरण: गंभीर झगड़े हुए)"
            },
            "enum": [
                {
                    "id": "1",
